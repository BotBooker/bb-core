# Скопируйте в deploy/.env и заполните. Не коммитьте реальные секреты.
POSTGRES_PASSWORD=change-me-hex
JWT_SECRET=change-me-32-bytes-minimum
PUBLIC_BASE_URL=http://localhost:8080
HTTP_PORT=8080
GRPC_PORT=50051
VERSION=dev
LOG_LEVEL=INFO

# Для docker compose run --rm bootstrap
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me-please
SUPERUSER_FIRST_NAME=Super
SUPERUSER_LAST_NAME=Admin

# OTLP (необязательно)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_METRICS_EXPORTER=none
