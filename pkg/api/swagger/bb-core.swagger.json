{
  "swagger": "2.0",
  "info": {
    "title": "API v1 для работы с сервисом BotBooker",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "UserService",
      "description": "Сервис для управления пользователями"
    },
    {
      "name": "AuthService",
      "description": "Сервис аутентификации: регистрация, вход, смена пароля и выход.\n\nРегистрация, вход и смена пароля открыты (токена ещё нет либо он недоступен):\nличность подтверждает пароль. Выход и чтение профиля требуют токен."
    }
  ],
  "basePath": "/api/v1",
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Войти по email и паролю и получить токен доступа",
        "operationId": "Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AuthServiceLoginResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1AuthServiceLoginRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Выйти из системы: отозвать токен из заголовка Authorization",
        "operationId": "Logout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1AuthServiceLogoutRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Получить профиль действующего пользователя (пользователь берётся из токена)",
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AuthServiceGetCurrentUserResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "AuthService"
        ]
      }
    },
    "/auth/password": {
      "post": {
        "summary": "Сменить пароль, подтвердив личность текущим паролем, и выдать новую сессию",
        "operationId": "ChangePassword",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AuthServiceChangePasswordResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1AuthServiceChangePasswordRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Зарегистрировать нового пользователя (роль client) и сразу выдать токен",
        "operationId": "Register",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AuthServiceRegisterResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1AuthServiceRegisterRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/users": {
      "post": {
        "summary": "Создать нового пользователя",
        "operationId": "Create",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UserServiceCreateResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1UserServiceCreateRequest"
            }
          }
        ],
        "tags": [
          "UserService"
        ]
      }
    },
    "/users/{uuid}": {
      "get": {
        "summary": "Получить пользователя по UUID",
        "operationId": "Get",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UserServiceGetResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uuid",
            "description": "UUID пользователя обязателен и должен быть валидным UUID",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "UserService"
        ]
      },
      "delete": {
        "summary": "Удалить пользователя",
        "operationId": "Delete",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uuid",
            "description": "UUID удаляемого пользователя",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "UserService"
        ]
      },
      "patch": {
        "summary": "Обновить данные пользователя",
        "operationId": "Update",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UserServiceUpdateResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uuid",
            "description": "UUID обновляемого пользователя",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UserServiceUpdateBody"
            }
          }
        ],
        "tags": [
          "UserService"
        ]
      }
    },
    "/users/{uuid}/global-operator": {
      "delete": {
        "summary": "Снять с пользователя права глобального оператора.\nДоступно только суперпользователю; суперпользователя изменить нельзя.",
        "operationId": "RevokeGlobalOperator",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uuid",
            "description": "UUID пользователя, с которого снимают права глобального оператора",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "UserService"
        ]
      },
      "post": {
        "summary": "Назначить пользователя глобальным оператором.\nДоступно только суперпользователю: глобальный оператор администрирует все\nтенанты независимо от роли в членстве.",
        "operationId": "AssignGlobalOperator",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UserServiceAssignGlobalOperatorResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "uuid",
            "description": "UUID пользователя, которому выдают права глобального оператора",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "UserService"
        ]
      }
    }
  },
  "definitions": {
    "UserServiceUpdateBody": {
      "type": "object",
      "properties": {
        "first_name": {
          "type": "string",
          "title": "Поля обернуты в wrappers для поддержки частичного обновления (PATCH)"
        },
        "last_name": {
          "type": "string"
        },
        "middle_name": {
          "type": "string"
        },
        "phone_number": {
          "type": "string"
        },
        "gender": {
          "type": "integer",
          "format": "int32",
          "title": "Ссылка на обертку для Enum, чтобы отличать \"не передано\" от \"значение 0\""
        },
        "birthday": {
          "$ref": "#/definitions/typeDate",
          "title": "Новая дата рождения"
        }
      },
      "title": "Запрос на обновление пользователя"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "typeDate": {
      "type": "object",
      "properties": {
        "year": {
          "type": "integer",
          "format": "int32",
          "description": "Year of the date. Must be from 1 to 9999, or 0 to specify a date without\na year."
        },
        "month": {
          "type": "integer",
          "format": "int32",
          "description": "Month of a year. Must be from 1 to 12, or 0 to specify a year without a\nmonth and day."
        },
        "day": {
          "type": "integer",
          "format": "int32",
          "description": "Day of a month. Must be from 1 to 31 and valid for the year and month, or 0\nto specify a year by itself or a year and month where the day isn't\nsignificant."
        }
      },
      "description": "* A full date, with non-zero year, month, and day values.\n* A month and day, with a zero year (for example, an anniversary).\n* A year on its own, with a zero month and a zero day.\n* A year and month, with a zero day (for example, a credit card expiration\n  date).\n\nRelated types:\n\n* [google.type.TimeOfDay][google.type.TimeOfDay]\n* [google.type.DateTime][google.type.DateTime]\n* [google.protobuf.Timestamp][google.protobuf.Timestamp]",
      "title": "Represents a whole or partial calendar date, such as a birthday. The time of\nday and time zone are either specified elsewhere or are insignificant. The\ndate is relative to the Gregorian Calendar. This can represent one of the\nfollowing:"
    },
    "v1AuthServiceChangePasswordRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "title": "Email пользователя"
        },
        "current_password": {
          "type": "string",
          "title": "Текущий пароль"
        },
        "new_password": {
          "type": "string",
          "title": "Новый пароль: не короче 8 символов"
        }
      },
      "title": "Запрос на смену пароля: личность подтверждает текущий пароль"
    },
    "v1AuthServiceChangePasswordResponse": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/definitions/v1Session",
          "title": "Выданный доступ"
        }
      },
      "title": "Ответ на смену пароля: новая сессия"
    },
    "v1AuthServiceGetCurrentUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User",
          "title": "Профиль действующего пользователя"
        }
      },
      "title": "Ответ с профилем действующего пользователя"
    },
    "v1AuthServiceLoginRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "title": "Email зарегистрированного пользователя"
        },
        "password": {
          "type": "string",
          "title": "Пароль пользователя"
        }
      },
      "title": "Запрос на вход по email и паролю"
    },
    "v1AuthServiceLoginResponse": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/definitions/v1Session",
          "title": "Выданный доступ"
        }
      },
      "title": "Ответ на вход: выданная сессия"
    },
    "v1AuthServiceLogoutRequest": {
      "type": "object",
      "title": "Запрос на выход из системы (токен берётся из заголовка Authorization)"
    },
    "v1AuthServiceRegisterRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "title": "Email обязателен и должен быть валидным адресом"
        },
        "first_name": {
          "type": "string",
          "title": "Имя: от 1 до 100 символов"
        },
        "last_name": {
          "type": "string",
          "title": "Фамилия: от 1 до 100 символов"
        },
        "middle_name": {
          "type": "string",
          "title": "Отчество (опционально, до 100 символов)"
        },
        "phone_number": {
          "type": "string",
          "title": "Номер телефона в формате E.164 (необязательно, пустое значение допустимо)"
        },
        "gender": {
          "$ref": "#/definitions/v1Gender",
          "title": "Пол пользователя (по умолчанию GENDER_UNSPECIFIED)"
        },
        "password": {
          "type": "string",
          "title": "Пароль: не короче 8 символов и не длиннее 128"
        }
      },
      "title": "Запрос на самостоятельную регистрацию: профиль и пароль"
    },
    "v1AuthServiceRegisterResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User",
          "title": "Созданный пользователь"
        },
        "session": {
          "$ref": "#/definitions/v1Session",
          "title": "Выданный доступ"
        }
      },
      "title": "Ответ на регистрацию: созданный пользователь и выданная сессия"
    },
    "v1Gender": {
      "type": "string",
      "enum": [
        "GENDER_UNSPECIFIED",
        "GENDER_MALE",
        "GENDER_FEMALE"
      ],
      "default": "GENDER_UNSPECIFIED",
      "description": "- GENDER_UNSPECIFIED: Пол не указан\n - GENDER_MALE: Мужской пол\n - GENDER_FEMALE: Женский пол",
      "title": "Перечисление для указания пола пользователя"
    },
    "v1Session": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "title": "Подписанный JWT: клиент присылает его в заголовке Authorization"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "title": "Момент, когда токен перестаёт действовать"
        }
      },
      "title": "Выданный доступ: подписанный токен и срок его действия"
    },
    "v1User": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "title": "Уникальный идентификатор пользователя (UUIDv4)"
        },
        "email": {
          "type": "string",
          "title": "Электронная почта"
        },
        "first_name": {
          "type": "string",
          "title": "Имя пользователя"
        },
        "last_name": {
          "type": "string",
          "title": "Фамилия пользователя"
        },
        "middle_name": {
          "type": "string",
          "title": "Отчество пользователя (при наличии)"
        },
        "phone_number": {
          "type": "string",
          "title": "Номер телефона в международном формате"
        },
        "gender": {
          "$ref": "#/definitions/v1Gender",
          "title": "Пол пользователя"
        },
        "birthday": {
          "$ref": "#/definitions/typeDate",
          "title": "Дата рождения пользователя"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "title": "Время создания профиля"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "title": "Время последнего обновления профиля"
        },
        "is_superuser": {
          "type": "boolean",
          "description": "Суперпользователь: назначается только bootstrap и управляет всеми\nобъектами и тенантами. Через API флаг не меняется."
        },
        "is_global_operator": {
          "type": "boolean",
          "description": "Глобальный оператор: назначен суперпользователем и администрирует все\nтенанты независимо от роли в членстве."
        }
      },
      "title": "Модель пользователя"
    },
    "v1UserServiceAssignGlobalOperatorResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User",
          "title": "Обновлённый пользователь"
        }
      },
      "title": "Ответ с пользователем, назначенным глобальным оператором"
    },
    "v1UserServiceCreateRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "title": "Email обязателен к заполнению и должен быть валидным адресом"
        },
        "first_name": {
          "type": "string",
          "title": "Имя должно быть от 1 до 100 символов"
        },
        "last_name": {
          "type": "string",
          "title": "Фамилия должна быть от 1 до 100 символов"
        },
        "middle_name": {
          "type": "string",
          "title": "Отчество (опционально, до 100 символов)"
        },
        "phone_number": {
          "type": "string",
          "description": "Номер телефона в формате E.164 (например, +79991234567).\nПоле необязательное: пустое значение не проверяется (ignore_empty)."
        },
        "gender": {
          "$ref": "#/definitions/v1Gender",
          "title": "Пол пользователя (по умолчанию UNSPECIFIED, если не передан)"
        },
        "birthday": {
          "$ref": "#/definitions/typeDate",
          "title": "Дата рождения пользователя"
        }
      },
      "title": "Запрос на создание пользователя"
    },
    "v1UserServiceCreateResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User",
          "title": "Созданный пользователь"
        }
      },
      "title": "Ответ с данными созданного пользователя"
    },
    "v1UserServiceGetResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User",
          "title": "Найденный пользователь"
        }
      },
      "title": "Ответ с данными запрошенного пользователя"
    },
    "v1UserServiceUpdateResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User",
          "title": "Обновленный пользователь"
        }
      },
      "title": "Ответ с обновленными данными пользователя"
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "description": "Введите JWT токен в формате: 'Bearer [token]'",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
