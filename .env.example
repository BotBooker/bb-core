SERVER_PORT=8080
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=60

AUTH_API_KEYS=test-api-key-1,test-api-key-2

DATABASE_DRIVER=postgres
DATABASE_DSN=postgres://user:password@localhost:5432/scheduling?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=5
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

LOGGING_LEVEL=info
LOGGING_JSON=false
